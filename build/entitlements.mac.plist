<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hardened-runtime entitlements for a signed, notarised macOS build.

  Apple will not notarise an app unless it is signed with the hardened runtime,
  and the hardened runtime switches off things Chromium needs unless they are
  asked for back here. Each of these is the minimum Electron requires, not a
  blanket permission:

  - allow-jit and allow-unsigned-executable-memory: V8 compiles JavaScript to
    machine code at runtime, which the hardened runtime blocks by default.
  - allow-dyld-environment-variables and disable-library-validation: Electron
    loads its own framework and helper binaries from inside the bundle.
  - files.user-selected.read-write: the whole app is a file editor, and every
    plan it opens arrives through an open/save panel.
  - print: plans are printed to PDF through Chromium's print pipeline.

  There is deliberately no network entitlement. Groundplan talks to no server,
  and the update check is a user-initiated download rather than a background
  service, so nothing here should widen if that stays true.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <key>com.apple.security.print</key>
    <true/>
  </dict>
</plist>
